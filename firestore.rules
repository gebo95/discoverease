rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && request.auth.token.keys().hasAny(['admin'])
        && request.auth.token.admin == true;
    }

    function isBusinessOwner(businessId) {
      return signedIn()
        && request.auth.token.keys().hasAny(['business_id'])
        && request.auth.token.business_id == businessId;
    }

    // Web links must be empty or a plain http(s) address, so values such as
    // javascript: can never be stored and later opened from a listing.
    function validWebLink(value) {
      return value is string
        && value.size() <= 300
        && (value == '' || value.matches('https?://[^ ]+[.][^ ]+'));
    }

    // Optional business-provided details on an experience. A missing field is
    // fine; a present one must have the right type and a sane length.
    function validExperienceDetails(data) {
      return (!('address' in data) || (data.address is string && data.address.size() <= 200))
        && (!('phone' in data) || (data.phone is string && data.phone.size() <= 40))
        && (!('hours' in data) || (data.hours is string && data.hours.size() <= 300))
        && (!('schedule' in data) || (data.schedule is string && data.schedule.size() <= 300))
        && (!('website' in data) || validWebLink(data.website))
        && (!('bookingUrl' in data) || validWebLink(data.bookingUrl))
        && (!('photos' in data) || (data.photos is list && data.photos.size() <= 5));
    }

    // A proposed change to a live experience. It may only contain reviewable
    // content, must be well-formed, and cannot change the photo until photo
    // uploads have their own checks. It never touches the live fields.
    function validRevision(rev, live) {
      return rev is map
        && rev.keys().hasOnly([
          'title', 'description', 'category', 'subcategory', 'destinationId',
          'destination', 'location', 'price', 'imageUrl', 'address', 'website',
          'bookingUrl', 'phone', 'hours', 'schedule', 'photos'
        ])
        && rev.keys().hasAll([
          'title', 'description', 'category', 'subcategory', 'destinationId',
          'destination', 'location', 'price', 'imageUrl'
        ])
        && rev.title is string && rev.title.size() > 0 && rev.title.size() <= 200
        && rev.description is string && rev.description.size() <= 5000
        && rev.category is string && rev.category.size() <= 100
        && rev.subcategory is string && rev.subcategory.size() <= 100
        && rev.destinationId is string && rev.destinationId.size() <= 100
        && rev.destination is string && rev.destination.size() <= 100
        && rev.location is string && rev.location.size() <= 200
        && rev.price is string && rev.price.size() <= 50
        && rev.imageUrl == live.imageUrl
        && validExperienceDetails(rev);
    }

    function ownsBusiness(businessId) {
      return signedIn() && (
        isBusinessOwner(businessId)
        || get(/databases/$(database)/documents/businesses/$(businessId)).data.ownerUid
          == request.auth.uid
      );
    }

    match /users/{userId} {
      allow read, delete: if signedIn() && request.auth.uid == userId;
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.id == userId
        && request.resource.data.schemaVersion == 1
        && request.resource.data.keys().hasOnly([
          'id', 'schemaVersion', 'name', 'homeLocation', 'userType',
          'savedListIds', 'tripIds'
        ]);
      allow update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.id == resource.data.id
        && request.resource.data.schemaVersion == 1
        && request.resource.data.keys().hasOnly([
          'id', 'schemaVersion', 'name', 'homeLocation', 'userType',
          'savedListIds', 'tripIds'
        ]);

      match /trips/{tripId} {
        allow read, delete: if signedIn() && request.auth.uid == userId;
        allow create, update: if signedIn()
          && request.auth.uid == userId
          && request.resource.data.id == tripId
          && request.resource.data.schemaVersion == 1
          && request.resource.data.keys().hasAll([
            'id', 'title', 'destination', 'destinationId', 'startDate',
            'endDate', 'days', 'estimatedBudget', 'lifecycle'
          ])
          && request.resource.data.lifecycle in ['current', 'upcoming']
          && request.resource.data.keys().hasOnly([
            'schemaVersion', 'id', 'title', 'destination', 'destinationId',
            'startDate', 'endDate', 'days', 'estimatedBudget', 'lifecycle'
          ]);
      }

      match /saved/{listingId} {
        allow read, delete: if signedIn() && request.auth.uid == userId;
        allow create, update: if signedIn()
          && request.auth.uid == userId
          && request.resource.data.listingId == listingId
          && request.resource.data.schemaVersion == 1
          && request.resource.data.keys().hasAll([
            'id', 'listingId', 'destination', 'listName'
          ])
          && request.resource.data.keys().hasOnly([
            'schemaVersion', 'id', 'listingId', 'destination', 'listName'
          ]);
      }

      match /likes/{listingId} {
        allow get, list, delete: if signedIn() && request.auth.uid == userId;
        allow create: if signedIn()
          && request.auth.uid == userId
          && request.resource.data.schemaVersion == 1
          && request.resource.data.listingId == listingId
          && request.resource.data.keys().hasOnly([
            'schemaVersion', 'listingId', 'createdAt'
          ])
          && exists(/databases/$(database)/documents/catalog/$(listingId))
          && get(/databases/$(database)/documents/catalog/$(listingId)).data.status
            == 'published';
        allow update: if false;
      }
    }

    match /businesses/{businessId} {
      // Business profiles hold private contact details (email, phone, owner
      // uid), so only the owner and admins can read them. Public listing
      // content lives in `catalog`, not here.
      allow get, list: if isAdmin()
        || isBusinessOwner(businessId)
        || (signedIn() && businessId == request.auth.uid)
        || (signedIn() && resource.data.ownerUid == request.auth.uid);
      allow create: if isAdmin()
        || (signedIn()
          && businessId == request.auth.uid
          && request.resource.data.ownerUid == request.auth.uid
          && request.resource.data.id == businessId
          && request.resource.data.schemaVersion == 1
          && request.resource.data.status == 'pending_review'
          && request.resource.data.verified == false
          && request.resource.data.subscriptionTier == 'free'
          && request.resource.data.keys().hasAll([
            'schemaVersion', 'id', 'ownerUid', 'name', 'email', 'phone',
            'website', 'instagram', 'status', 'verified', 'subscriptionTier',
            'createdAt'
          ])
          && request.resource.data.keys().hasOnly([
            'schemaVersion', 'id', 'ownerUid', 'name', 'email', 'phone',
            'website', 'instagram', 'status', 'verified', 'subscriptionTier',
            'createdAt'
          ]));
      allow update: if isAdmin()
        || (ownsBusiness(businessId)
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.id == resource.data.id
          && request.resource.data.status == resource.data.status
          && request.resource.data.verified == resource.data.verified
          && request.resource.data.subscriptionTier == resource.data.subscriptionTier
          && request.resource.data.schemaVersion == 1
          && request.resource.data.get('reviewedAt', null)
            == resource.data.get('reviewedAt', null)
          && request.resource.data.get('reviewedBy', null)
            == resource.data.get('reviewedBy', null)
          && request.resource.data.keys().hasOnly([
            'schemaVersion', 'id', 'ownerUid', 'name', 'email', 'phone',
            'website', 'instagram', 'status', 'verified', 'subscriptionTier',
            'createdAt', 'reviewedAt', 'reviewedBy'
          ]));
      // Once a business is published, only an admin may delete its parent.
      // This prevents orphaning public catalog records through owner deletion.
      allow delete: if isAdmin()
        || (ownsBusiness(businessId) && resource.data.status != 'published');

      match /experiences/{experienceId} {
        allow get, list: if isAdmin()
          || ownsBusiness(businessId)
          || resource.data.status == 'published';
        allow create: if isAdmin()
          || (ownsBusiness(businessId)
            && request.resource.data.id == experienceId
            && request.resource.data.schemaVersion == 1
            && request.resource.data.status == 'pending_review'
            && request.resource.data.keys().hasAll([
              'schemaVersion', 'id', 'title', 'description', 'category',
              'subcategory', 'destinationId', 'destination', 'location',
              'price', 'imageUrl', 'status', 'createdAt', 'updatedAt'
            ])
            && request.resource.data.keys().hasOnly([
              'schemaVersion', 'id', 'title', 'description', 'category',
              'subcategory', 'destinationId', 'destination', 'location',
              'price', 'imageUrl', 'status', 'createdAt', 'updatedAt',
              'address', 'website', 'bookingUrl', 'phone', 'hours', 'schedule',
              'photos'
            ])
            && validExperienceDetails(request.resource.data));
        allow update: if isAdmin()
          || (ownsBusiness(businessId)
            && request.resource.data.schemaVersion == 1
            && request.resource.data.id == resource.data.id
            && request.resource.data.keys().hasOnly([
              'schemaVersion', 'id', 'title', 'description', 'category',
              'subcategory', 'destinationId', 'destination', 'location',
              'price', 'imageUrl', 'status', 'createdAt', 'updatedAt',
              'reviewNote', 'reviewedAt', 'reviewedBy',
              'address', 'website', 'bookingUrl', 'phone', 'hours', 'schedule',
              'pendingRevision', 'revisionStatus', 'revisionNote',
              'revisionSubmittedAt',
              'availability', 'availabilityMessage', 'availabilityChangedAt',
              'endsAt', 'photos'
            ])
            && validExperienceDetails(request.resource.data)
            && (
              (resource.data.status == 'pending_review'
                && request.resource.data.status == 'pending_review'
                && request.resource.data.diff(resource.data).affectedKeys()
                  .hasOnly([
                    'title', 'description', 'category', 'subcategory',
                    'destinationId', 'destination', 'location', 'price',
                    'imageUrl', 'updatedAt',
                    'address', 'website', 'bookingUrl', 'phone', 'hours', 'schedule',
                    'photos'
                  ]))
              || (resource.data.status == 'rejected'
                && request.resource.data.status == 'pending_review'
                && request.resource.data.reviewNote == ''
                && request.resource.data.reviewedAt == null
                && request.resource.data.reviewedBy == null
                && request.resource.data.diff(resource.data).affectedKeys()
                  .hasOnly([
                    'title', 'description', 'category', 'subcategory',
                    'destinationId', 'destination', 'location', 'price',
                    'imageUrl', 'updatedAt', 'status', 'reviewNote',
                    'reviewedAt', 'reviewedBy',
                    'address', 'website', 'bookingUrl', 'phone', 'hours', 'schedule',
                    'photos'
                  ]))
              // Live experiences are never edited directly. The owner can only
              // propose a revision (or withdraw one); an admin applies it.
              || (resource.data.status == 'published'
                && request.resource.data.status == 'published'
                && request.resource.data.diff(resource.data).affectedKeys()
                  .hasOnly([
                    'pendingRevision', 'revisionStatus', 'revisionNote',
                    'revisionSubmittedAt', 'updatedAt'
                  ])
                && (
                  (request.resource.data.revisionStatus == 'pending_review'
                    && request.resource.data.revisionNote == ''
                    && request.resource.data.revisionSubmittedAt == request.time
                    && validRevision(
                      request.resource.data.pendingRevision, resource.data))
                  || (!('pendingRevision' in request.resource.data)
                    && !('revisionStatus' in request.resource.data)
                    && !('revisionNote' in request.resource.data)
                    && !('revisionSubmittedAt' in request.resource.data))
                ))
            ));
        // Published catalog entries are moderated records and must be removed
        // by the same trusted path that removes their public catalog document.
        allow delete: if isAdmin()
          || (ownsBusiness(businessId) && resource.data.status != 'published');
      }
    }

    // Recursive match enables the admin-only collectionGroup moderation query.
    // Existing nested rules continue to grant owners their scoped access.
    match /{path=**}/experiences/{experienceId} {
      allow get, list: if isAdmin();
    }

    match /catalog/{experienceId} {
      allow get, list: if resource.data.status == 'published';
      allow create, update, delete: if isAdmin();
    }

    // Short public notice left behind when a listing is hidden, ended or
    // removed, so travelers who saved it see why. Holds nothing private and is
    // written only by Cloud Functions, never by a client.
    match /unavailable/{listingId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    match /businesses/{businessId}/analytics/{listingId} {
      allow get, list: if isAdmin() || ownsBusiness(businessId);
      allow create, update, delete: if false;

      match /daily/{dateId} {
        allow get, list: if isAdmin() || ownsBusiness(businessId);
        allow create, update, delete: if false;
      }
    }

    // Client apps must never write privileged role grants or admin records.
    match /admin/{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
