# Copy to functions/.env.discoverease-dev and fill in (safe to commit: none of these are secrets).
# These are NOT secrets. The two Stripe keys are set with
#   firebase functions:secrets:set STRIPE_SECRET_KEY
#   firebase functions:secrets:set STRIPE_WEBHOOK_SECRET
APP_URL=https://your-app-address
STRIPE_PRICE_PLUS=price_xxx
STRIPE_PRICE_PRO=price_xxx
STRIPE_PRICE_PACK5=price_xxx
STRIPE_PRICE_PACK15=price_xxx
STRIPE_PRICE_FEATURED7=price_xxx
STRIPE_PRICE_FEATURED30=price_xxx
# The address claim-code emails come from. For testing, leave this out and
# Resend's own test sender is used (it only delivers to your own Resend email).
# CLAIM_FROM_EMAIL=DiscoverEase <claims@your-domain.com>
