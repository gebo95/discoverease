rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    // Ownership comes from the business's Firestore document, not a sign-in
    // claim, so approving or creating a business never needs a claim update.
    // Fails closed if the business document does not exist.
    function ownsBusiness(businessId) {
      return signedIn()
        && firestore.get(/databases/(default)/documents/businesses/$(businessId)).data.ownerUid
          == request.auth.uid;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.get('admin', false) == true;
    }

    // Owners upload here. Nothing in this folder is public: only the owner and
    // reviewers can read it. Files are never overwritten, so an approved
    // upload cannot be swapped for different content afterwards.
    match /pending/{businessId}/{experienceId}/{fileName} {
      allow read: if ownsBusiness(businessId) || isAdmin();
      allow create: if resource == null
        && ownsBusiness(businessId)
        && fileName.matches('[A-Za-z0-9_-]{1,80}[.](jpg|jpeg|png|webp)')
        && request.resource.size > 0
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
      allow update: if false;
      allow delete: if ownsBusiness(businessId) || isAdmin();
    }

    // Approved photos. Anyone can see them; only the server (which bypasses
    // these rules) can add or remove them, after an admin approves.
    match /public/{businessId}/{experienceId}/{fileName} {
      allow read: if true;
      allow write: if false;
    }
  }
}
